{
  "name": "@ojcp/sandbox",
  "version": "0.0.0",
  "description": "A test-only OJCP world on separate origins: issuer, attesters, a trust-list publisher, demo providers and a demo agent. Every key is a sandbox key.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown && vite build --config ui/vite.config.ts && tsc -p ui && tsc -b",
    "start": "node dist/main.mjs",
    "local": "node --conditions=source scripts/local.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@ojcp/agent-wallet": "workspace:*",
    "@ojcp/credentials-core": "workspace:*",
    "@ojcp/issuer": "workspace:*",
    "@ojcp/trust": "workspace:*",
    "@ojcp/verifier": "workspace:*",
    "@peculiar/x509": "^2.1.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tabler/icons-react": "^3.49.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite": "^8.3.4"
  }
}
